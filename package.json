{
  "name": "hansogj-monorepo",
  "version": "0.0.5",
  "private": true,
  "description": "monorepo root for @hansogj/music-utils and its libraries",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --sequential --if-present build",
    "test": "pnpm -r --sequential --if-present test",
    "lint": "pnpm -r --sequential --if-present lint",
    "format:check": "pnpm -r --sequential --if-present format:check",
    "precommit": "pnpm -r --sequential --if-present precommit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "update": "npx npm-check-updates -i -t minor --deep && pnpm run post:update",
    "update:majors": "npx npm-check-updates -i -t latest --deep && pnpm run post:update",
    "post:update": "rm -rfv node_modules && pnpm prune && pnpm i"
  },
  "author": "hansogj@gmail.com",
  "license": "UNLICENSED",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "husky": "9.1.7",
    "npm-run-all2": "9.0.3",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "^1.1.16",
      "brace-expansion@>=2 <5": "^2.1.3",
      "brace-expansion@>=5": "^5.0.9",
      "postcss": "^8.5.18",
      "esbuild": "^0.28.1"
    }
  },
  "volta": {
    "node": "26.4.0"
  }
}
