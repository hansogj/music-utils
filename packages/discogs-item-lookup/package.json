{
  "name": "@hansogj/discogs-item-lookup",
  "version": "1.5.0",
  "description": "A CLI and library to look up item details from the Discogs API.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "discogs-lookup": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup",
    "cli": "node dist/cli.js",
    "test": "vitest run",
    "prepack": "pnpm format:check && pnpm test &&  pnpm build",
    "precommit": "pnpm prepack",
    "prepublishOnly": "npm run build",
    "test:watch": "vitest",
    "format": "prettier --write . --ignore-path=../../.prettierignore",
    "format:check": "prettier --check . --ignore-path=../../.prettierignore",
    "post:update": "rm -rfv node_modules && pnpm prune && pnpm i",
    "update:majors": "npx npm-check-updates -i -t latest && pnpm run post:update",
    "update": "npx npm-check-updates -i -t minor && pnpm run post:update"
  },
  "keywords": [
    "discogs",
    "api",
    "cli",
    "music",
    "vinyl",
    "lookup"
  ],
  "author": "Hans Ole Gjerdrem",
  "license": "ISC",
  "dependencies": {
    "@hansogj/maybe": "2.7.3",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hansogj/music-utils",
    "directory": "packages/discogs-item-lookup"
  },
  "bugs": {
    "url": "https://github.com/hansogj/music-utils/issues"
  },
  "homepage": "https://github.com/hansogj/music-utils/tree/main/packages/discogs-item-lookup#readme"
}
