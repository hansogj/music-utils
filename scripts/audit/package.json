{
  "name": "@hansogj/music-audit",
  "private": true,
  "version": "0.2.0",
  "description": "Music library audit CLI \u2014 library audit, interactive repair, Discogs enrichment",
  "type": "module",
  "main": "./dist/music-audit.js",
  "exports": {
    ".": "./dist/music-audit.js"
  },
  "bin": {
    "music-audit": "./dist/music-audit.js",
    "music-audit-completion": "./dist/music-audit-completion.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "audit": "tsx src/audit.ts",
    "test": "tsx src/audit.ts --root=../../packages/music-utils/test-data/raw --no-discogs",
    "completion": "tsx src/completion.ts bash",
    "vitest": "vitest run",
    "vitest:watch": "vitest watch",
    "vitest:ci": "vitest run --coverage",
    "build": "tsup",
    "lint": "eslint .",
    "precommit": "pnpm run lint && pnpm run format:check && pnpm run vitest:ci && pnpm run build",
    "format": "prettier --write src README.md eslint.config.mjs vitest.config.ts tsup.config.ts --ignore-path=../../.prettierignore",
    "format:check": "prettier --check src README.md eslint.config.mjs vitest.config.ts tsup.config.ts --ignore-path=../../.prettierignore"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
