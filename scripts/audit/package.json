{
  "name": "@hansogj/music-audit",
  "private": true,
  "version": "0.2.0",
  "description": "Music library audit CLI — library audit, interactive repair, Discogs enrichment",
  "type": "module",
  "main": "./dist/music-audit.js",
  "exports": {
    ".": "./dist/music-audit.js"
  },
  "bin": {
    "music-audit": "./dist/music-audit.js",
    "music-audit-completion": "./dist/music-audit-completion.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "audit": "tsx src/audit.ts",
    "test": "tsx src/audit.ts --root=../../packages/music-utils/test-data/raw --no-discogs",
    "completion": "tsx src/completion.ts bash",
    "vitest": "vitest run",
    "vitest:watch": "vitest watch",
    "vitest:ci": "vitest run --coverage",
    "build": "tsup",
    "lint": "echo 'no lint configured yet'",
    "precommit": "pnpm run vitest:ci && pnpm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
